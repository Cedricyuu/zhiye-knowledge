# Reference only. Spring Boot does not automatically load this file.
# Set these environment variables in the shell that starts scripts/start.ps1.
KB_PORT=8088
KB_BIND_ADDRESS=127.0.0.1
KB_AI_ENABLED=false
KB_AI_BASE_URL=
KB_AI_MODEL=
KB_AI_API_KEY=
# MySQL only: set SPRING_PROFILES_ACTIVE=mysql and supply a dedicated database.
# The bundled scripts/use-mysql.ps1 route manages its own local instance and credentials;
# these fields are only needed for scripts/start.ps1 -Database external.
KB_DB_URL=jdbc:mysql://127.0.0.1:3306/ai_knowledge?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
KB_DB_USERNAME=knowledge
KB_DB_PASSWORD=
